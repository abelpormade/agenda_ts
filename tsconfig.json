{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",

    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,

    "resolvePackageJsonExports": false,

    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,

    "strict": false
  },

  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "eslint.config.mjs"
  ]
}
